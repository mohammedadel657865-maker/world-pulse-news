<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>2027</title><style>*{margin:0;padding:0;box-sizing:border-box}body{background:#0f3d0f;font-family:system-ui;overflow:hidden;height:100vh;color:#fff}#header{background:#000;padding:10px 15px;display:flex;justify-content:space-between;align-items:center}#header h1{color:#00ff88;font-size:22px}#scoreboard{background:rgba(255,255,255,.15);padding:6px 14px;border-radius:20px;font-weight:900}#pitch{position:relative;width:100%;height:calc(100vh - 110px);background:radial-gradient(#1a7a1a,#0f3d0f);border-top:3px solid #fff;border-bottom:3px solid #fff}#goal{position:absolute;left:50%;top:0;transform:translateX(-50%);width:220px;height:14px;background:#fff;box-shadow:0 0 0 6px #ccc;border-radius:0 0 10px 10px;z-index:5}#keeper{position:absolute;left:50%;top:12px;transform:translateX(-50%);width:50px;height:50px;background:red;border-radius:50%;border:3px solid #fff;display:flex;align-items:center;justify-content:center;font-size:24px;transition:left .3s;z-index:6}#ball{position:absolute;left:50%;bottom:80px;transform:translateX(-50%);width:42px;height:42px;background:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:20px;transition:all .4s;z-index:7}#controls{position:absolute;bottom:0;left:0;right:0;height:90px;background:rgba(0,0,0,.7);display:flex;align-items:center;justify-content:center;gap:12px;z-index:10}.btn{width:70px;height:70px;border-radius:50%;border:3px solid #fff;background:#00ff88;color:#000;font-weight:900}#msg{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,.9);padding:20px 30px;border-radius:20px;font-size:24px;font-weight:900;display:none;z-index:20;text-align:center}#startScreen{position:absolute;inset:0;background:linear-gradient(#000,#0f3d0f);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:30;text-align:center;padding:20px}.cta{background:#00ff88;color:#000;border:none;padding:16px 40px;border-radius:30px;font-size:20px;font-weight:900;margin-top:20px}</style></head><body><div id="header"><h1>2027 ⚽</h1><div id="scoreboard">0 / 5</div></div><div id="pitch"><div id="goal"></div><div id="keeper">🧤</div><div id="ball">⚽</div><div id="msg"></div><div id="startScreen"><h1 style="font-size:50px">20<span style="color:#00ff88">27</span></h1><h2>FOOTBALL SHOOT</h2><p style="margin:15px 0;color:#aaa">سجل 5 أهداف عشان تكسب</p><button class="cta" onclick="startGame()">ابدأ اللعب 🚀</button></div><div id="controls"><button class="btn" onclick="shoot('left')">◀ شمال</button><button class="btn" style="background:#fff" onclick="shoot('center')">⬆ نص</button><button class="btn" onclick="shoot('right')">يمين ▶</button></div></div><script>let goals=0,playing=false;let keeper=document.getElementById('keeper');let ball=document.getElementById('ball');let scoreboard=document.getElementById('scoreboard');let msg=document.getElementById('msg');let startScreen=document.getElementById('startScreen');function startGame(){startScreen.style.display='none';goals=0;playing=true;updateScore();resetBall();}function updateScore(){scoreboard.innerText=goals+' / 5';}function resetBall(){ball.style.left='50%';ball.style.bottom='80px';ball.style.top='auto';keeper.style.left='50%';playing=true;}function shoot(dir){if(!playing)return;playing=false;let keeperDir=['left','center','right'][Math.floor(Math.random()*3)];if(dir==='left')keeper.style.left='35%';else if(dir==='right')keeper.style.left='65%';else keeper.style.left='50%';setTimeout(()=>{if(dir==='left')ball.style.left='35%';else if(dir==='right')ball.style.left='65%';else ball.style.left='50%';ball.style.bottom='auto';ball.style.top='20px';setTimeout(()=>{if(dir===keeperDir){showMsg('صدها! 🧤');}else{goals++;updateScore();showMsg('جوووول! ⚽');if(goals>=5){setTimeout(()=>{showMsg('بطل 2027! 🏆');setTimeout(startGame,2000);},800);return;}}setTimeout(()=>{msg.style.display='none';resetBall();},1000);},400);},300);}function showMsg(t){msg.innerHTML=t;msg.style.display='block';setTimeout(()=>{msg.style.display='none';},900);}</script></body></html>
