<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>2027 - لعبة الكورة</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background:#0f3d0f;font-family:system-ui;overflow:hidden;height:100vh;color:#fff;user-select:none}
#header{background:#000;padding:10px 15px;display:flex;justify-content:space-between;align-items:center}
#header h1{font-size:22px;letter-spacing:2px;color:#00ff88}
#header h1 span{color:#fff}
#scoreboard{background:rgba(255,255,255,.1);padding:6px 14px;border-radius:20px;font-weight:900}
#pitch{position:relative;width:100%;height:calc(100vh - 110px);background:radial-gradient(#1a7a1a,#0f3d0f);overflow:hidden;border-top:3px solid #fff;border-bottom:3px solid #fff}
#goal{position:absolute;left:50%;top:0;transform:translateX(-50%);width:220px;height:14px;background:#fff;box-shadow:0 0 0 6px #ccc;border-radius:0 0 10px 10px;z-index:5}
#keeper{position:absolute;left:50%;top:12px;transform:translateX(-50%);width:50px;height:50px;background:#ff1a1a;border-radius:50%;border:3px solid #fff;display:flex;align-items:center;justify-content:center;font-size:24px;transition:left .3s ease;z-index:6}
#ball{position:absolute;left:50%;bottom:80px;transform:translateX(-50%);width:42px;height:42px;background:#fff;border-radius:50%;border:2px solid #000;display:flex;align-items:center;justify-content:center;font-size:20px;box-shadow:0 5px 15px rgba(0,0,0,.5);transition:all .4s cubic-bezier(.2,.8,.3,1);z-index:7}
#controls{position:absolute;bottom:0;left:0;right:0;height:100px;background:rgba(0,0,0,.7);display:flex;align-items:center;justify-content:center;gap:12px;padding:10px;z-index:10}
.btn{width:70px;height:70px;border-radius:50%;border:3px solid #fff;background:#00ff88;color:#000;font-weight:900;font-size:16px;display:flex;flex-direction:column;align-items:center;justify-content:center}
#powerBar{position:absolute;left:50%;bottom:120px;transform:translateX(-50%);width:200px;height:12px;background:rgba(0,0,0,.5);border-radius:10px;overflow:hidden;display:none;z-index:8}
#powerFill{height:100%;width:0%;background:linear-gradient(90deg,#00ff88,#ffff00,#ff0000);transition:width .05s}
#msg{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,.9);padding:20px 30px;border-radius:20px;font-size:24px;font-weight:900;display:none;z-index:20;text-align:center}
#startScreen{position:absolute;inset:0;background:linear-gradient(#000,#0f3d0f);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:30;text-align:center;padding:20px}
.cta{background:#00ff88;color:#000;border:none;padding:16px 40px;border-radius:30px;font-size:20px;font-weight:900;margin-top:20px}
</style>
</head>
<body>
<div id="header"><h1>20<span>27</span> ⚽</h1><div id="scoreboard">0 / 5 أهداف</div></div>
<div id="pitch">
<div id="goal"></div>
<div id="keeper">🧤</div>
<div id="ball">⚽</div>
<div id="powerBar"><div id="powerFill"></div></div>
<div id="msg"></div>
<div id="startScreen">
<h1 style="font-size:50px">20<span style="color:#00ff88">27</span></h1>
<h2>FOOTBALL SHOOT</h2>
<p style="margin:15px 0;color:#aaa">تحدي ضربات الجزاء<br>سجل 5 أهداف عشان تكسب</p>
<button class="cta" onclick="startGame()">ابدأ اللعب 🚀</button>
<p style="margin-top:20px;font-size:11px;color:#555">BY MOHAMMED ADEL - WILL BE ON GOOGLE PLAY</p>
</div>
<div id="controls">
<button class="btn" onclick="shoot('left')">◀<span style="font-size:10px">شمال</span></button>
<button class="btn" style="background:#fff" onclick="shoot('center')">⬆<span style="font-size:10px">النص</span></button>
<button class="btn" onclick="shoot('right')">▶<span style="font-size:10px">يمين</span></button>
</div>
</div>
<script>
let goals=0, playing=false;
let keeper=document.getElementById('keeper');
let ball=document.getElementById('ball');
let scoreboard=document.getElementById('scoreboard');
let msg=document.getElementById('msg');
let powerBar=document.getElementById('powerBar');
let powerFill=document.getElementById('powerFill');
let startScreen=document.getElementById('startScreen');
function startGame(){startScreen.style.display='none';goals=0;playing=true;updateScore();resetBall();}
function updateScore(){scoreboard.innerText=goals+' / 5 أهداف';}
function resetBall(){ball.style.transition='none';ball.style.left='50%';ball.style.bottom='80px';ball.style.top='auto';keeper.style.left='50%';setTimeout(()=>{ball.style.transition='all .4s cubic-bezier(.2,.8,.3,1)';},50);playing=true;}
function shoot(dir){if(!playing)return;playing=false;let keeperDir=['left','center','right'][Math.floor(Math.random()*3)];if(dir==='left')keeper.style.left='35%';else if(dir==='right')keeper.style.left='65%';else keeper.style.left='50%';powerBar.style.display='block';let power=0;let int=setInterval(()=>{power+=4;if(power>100)power=0;powerFill.style.width=power+'%';},20);setTimeout(()=>{clearInterval(int);powerBar.style.display='none';if(dir==='left')ball.style.left='35%';else if(dir==='right')ball.style.left='65%';else ball.style.left='50%';ball.style.bottom='auto';ball.style.top='20px';setTimeout(()=>{if(dir===keeperDir){showMsg('صدها الحارس! 🧤');}else{goals++;updateScore();showMsg('جووووول! ⚽🔥');if(goals>=5){setTimeout(()=>{showMsg('كسبت! انت بطل 2027 🏆',true);setTimeout(startGame,2000);},800);return;}}setTimeout(()=>{msg.style.display='none';resetBall();},1000);},400);},400);}
function showMsg(t,stay=false){msg.innerHTML=t;msg.style.display='block';if(!stay)setTimeout(()=>{msg.style.display='none';},900);}
</script>
</body>
</html>
